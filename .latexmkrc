# .latexmkrc -- налаштування збірки для latexmk.
#
# Завдяки цьому файлу команда `latexmk` (без жодних прапорців) працює
# однаково на Windows і Linux: сама викликає XeLaTeX стільки разів,
# скільки потрібно (для змісту, посилань, бібліографії), і сама формує
# коректний PDF. Детальніше -- у README.md, розділ "Компіляція".

# 5 = використовувати XeLaTeX замість застарілого pdfLaTeX.
$pdf_mode = 5;

# Biber -- сучасний бекенд для biblatex (наш пакет бібліографії).
# Застарілий bibtex сюди не підходить -- він не розуміє UTF-8/Unicode
# так, як це потрібно для кириличних джерел.
$biber = 'biber %O %S';
